   "source": [
    "# SWAMP (SPARSE WEIGHT AVERAGING WITH MULTIPLE PARTICLES FOR ITERATIVE MAGNITUDE PRUNING)\n",
    "### (Moonseok С. et al., 2024)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 123,
   "metadata": {},
   "outputs": [],
   "source": [
    "import math\n",
    "from collections import defaultdict\n",
    "\n",
    "class SWAMPTrainer(IMPTrainer):\n",
    "    def __init__(self, model, trainer, pruning_ratio=0.2, num_particles=5, ticket_epochs=5):\n",
    "        super().__init__(model, trainer, pruning_ratio)\n",
    "        self.num_particles = num_particles\n",
    "        self.ticket_epochs = ticket_epochs\n",
    "\n",
    "        self.eval_log = []\n",
    "\n",
    "        print(f\"\\n[SWAMP] Pretraining to get matching ticket (T₀ = {self.ticket_epochs} epochs)...\")\n",
    "        for epoch in range(1, self.ticket_epochs + 1):\n",
    "            self.trainer.train(epoch)\n",
    "            self.trainer.test()\n",
    "            self.trainer.scheduler.step()\n",
    "        self.matching_ticket = {k: v.clone().detach() for k, v in self.model.state_dict().items()}\n",
    "\n",
    "    def _prune_from_weights(self, weights):\n",
    "\n",
    "      for name, param in self.model.named_parameters():\n",
    "          if name in self.masks:\n",
    "              weight_data = weights[name][self.masks[name]]\n",
    "              k = int(weight_data.numel() * self.pruning_ratio)\n",
    "              if k == 0:\n",
    "                  continue\n",
    "              threshold = weight_data.abs().kthvalue(k).values\n",
    "              new_mask = (weights[name].abs() > threshold) & self.masks[name]\n",
    "              self.masks[name] = new_mask\n",
    "\n",
    "    def run(self, C=10, T=10):\n",
    "        base_seed = 42\n",
    "        for c in range(1, C + 1):\n",
    "            print(f\"\\n[SWAMP Iteration {c}/{C}]\")\n",
    "\n",
    "            particle_weights = None\n",
    "\n",
    "            for n in range(1, self.num_particles + 1):\n",
    "                print(f\" Particle {n}/{self.num_particles}\")\n",
    "\n",
    "                # Разные источники стохастичности\n",
    "                torch.manual_seed(base_seed + n)\n",
    "                np.random.seed(base_seed + n)\n",
    "                random.seed(base_seed + n)\n",
    "\n",
    "                self.model.load_state_dict(self.matching_ticket)\n",
    "                self._apply_mask()\n",
    "\n",
    "                swa_accumulator = defaultdict(float)\n",
    "                swa_count = 0\n",
    "                swa_start_epoch = math.floor(0.75 * T) + 1\n",
    "\n",
    "                for epoch in range(1, T + 1):\n",
    "                    self.trainer.train(epoch)\n",
    "                    self.trainer.test()\n",
    "                    self.trainer.scheduler.step()\n",
    "\n",
    "                    if epoch >= swa_start_epoch:\n",
    "                        for name, param in self.model.state_dict().items():\n",
    "                            swa_accumulator[name] += param.clone().detach()\n",
    "                        swa_count += 1\n",
    "\n",
    "                # Усреднение по последним 25% эпох\n",
    "                for name in swa_accumulator:\n",
    "                    swa_accumulator[name] /= swa_count\n",
    "\n",
    "                if particle_weights is None:\n",
    "                    particle_weights = swa_accumulator\n",
    "                else:\n",
    "                    for k in particle_weights:\n",
    "                        particle_weights[k] += swa_accumulator[k]\n",
    "\n",
    "            # Усреднение по всем частицам\n",
    "            for k in particle_weights:\n",
    "                particle_weights[k] /= self.num_particles\n",
    "            self.model.load_state_dict(particle_weights)\n",
    "\n",
    "            # Прунинг по усреднённым весам\n",
    "            self._prune_from_weights(particle_weights)\n",
    "            self._log_sparsity(c)\n",
    "\n",
    "            # Прогон модели после прунинга\n",
    "            self.model.eval()\n",
    "            correct, total, running_loss = 0, 0, 0\n",
    "            with torch.no_grad():\n",
    "                for inputs, targets in self.trainer.testloader:\n",
    "                    inputs, targets = inputs.to(device), targets.to(device)\n",
    "                    outputs = self.model(inputs)\n",
    "                    loss = self.trainer.criterion(outputs, targets)\n",
    "                    running_loss += loss.item()\n",
    "                    _, predicted = outputs.max(1)\n",
    "                    total += targets.size(0)\n",
    "                    correct += predicted.eq(targets).sum().item()\n",
    "\n",
    "            test_loss = running_loss / len(self.trainer.testloader)\n",
    "            test_acc = 100. * correct / total\n",
    "\n",
    "            # Сохраняем результат\n",
    "            self.eval_log.append({\n",
    "                \"iteration\": c,\n",
    "                \"test_loss\": test_loss,\n",
    "                \"test_acc\": test_acc\n",
    "            })\n",
    "            print(f\"[SWAMP Iteration {c}] Averaged particles eval {test_loss:.3f} | Acc: {test_acc:.2f}%\")\n",
    "\n"
   ]
  },
