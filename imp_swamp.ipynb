    "wrn28_2_swamp_model_cos = WideResNet(depth=28, widen_factor=2).to(device)\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "optimizer = torch.optim.SGD(wrn28_2_swamp_model_cos.parameters(), lr=0.05, momentum=0.9, weight_decay=1e-4)\n",
    "scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=10)\n",
    "\n",
    "wrn28_2_swamp_trainer_cos = Trainer(\n",
    "    model=wrn28_2_swamp_model_cos,\n",
    "    trainloader=trainloader,\n",
    "    testloader=testloader,\n",
    "    criterion=criterion,\n",
    "    optimizer=optimizer,\n",
    "    scheduler=scheduler\n",
    ")\n",
    "\n",
    "swamp_reduce_cos = SWAMPTrainer(\n",
    "    model=wrn28_2_swamp_model_cos,\n",
    "    trainer=wrn28_2_swamp_trainer_cos,\n",
    "    pruning_ratio=0.2,\n",
    "    num_particles=3,\n",
    "    ticket_epochs = 10,\n",
    ")"
   ]
