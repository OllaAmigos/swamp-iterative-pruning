    "# Iterative Magnitude Pruning (IMP)\n",
    "### (Frankle et al., 2020)\n",
    "\n",
    "В данном проекте бейзлайн, улучшение которого предлагают авторы в качетсве основого результата статьи. Ниже приведен алгоритм IMP c rewinding (сброс весов до `matching ticket` - подсеть плотной сети, обеспечивающая качество не сильно хуже, не беря вов внимаени экстремальные уровни прунинга)\n",
    "\n",
    "**Алгоритм:**\n",
    "\n",
    "**Требуется:** параметры нейронной сети $w$, маска прунинга $m$, обучающий датасет $D$,\n",
    "число циклов прунинга $C$, число итераций на цикл $T$,\n",
    "коэффициент прунинга $\\alpha$, шум SGD $\\xi$, и число итераций для нахождения \"matching ticket\" $T_0$.\n",
    "\n",
    "**Выход:** разреженное решение $w_{c,T}$.\n",
    "\n",
    "1. Случайным образом инициализировать $w_{0,0}$ и задать маску $m \\leftarrow 1$.\n",
    "▷ Начинаем с плотных случайных весов.\n",
    "\n",
    "2. Обучить $w_{0,T_0} \\leftarrow \\text{SGD}{0 \\rightarrow T_0}(w{0,0} \\circ m, \\xi_0, D)$.\n",
    "▷ Получаем подходящий билет (matching ticket) из инициализации.\n",
    "\n",
    "Для каждого $c \\in {1, \\dots, C}$:\n",
    "\n",
    "4. Возврат: $w_{c,0} \\leftarrow w_{0,T_0} \\circ m$.\n",
    " ▷ Начинаем с matching ticket.\n",
    "\n",
    " 5. Обучить: $w_{c,T} \\leftarrow \\text{SGD}{0 \\rightarrow T}(w{c,0}, \\xi_c, D)$.\n",
    " ▷ Получаем траекторию весов.\n",
    "\n",
    " 6. Прунинг: $m \\leftarrow \\text{Prune}(w_{c,T}, \\alpha)$.\n",
    " ▷ Обновляем маску на основе величины весов."
    "\n",
    "**Дополнительно:** ищем след гессиана в _estimate_trace_hessian \n",
    "При помощи *Hutchinson’s Estimator* оцениваем след матрицы Гессиана на обучающем подмножестве\n",
    "**Идея:** для случайного вектора $v$ с $\mathbb{E}[vv^T] = I$, выполняется: $\mathbb{E}[v^T H v] = \mathrm{Tr}(H)$\n",
    "затем ( $v_k$ — случайные векторы) аппроксимируем след $\mathrm{Tr}(H) \approx \frac{1}{K} \sum_{k=1}^K v_k^T H v_k$\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "1VaVULEqg6n6"
   },
   "outputs": [],
   "source": [
    "class IMPTrainer:\n",
    "    def __init__(self, model, trainer, pruning_ratio=0.2):\n",
    "        self.model = model\n",
    "        self.trainer = trainer\n",
    "        self.pruning_ratio = pruning_ratio\n",
    "\n",
    "        self.initial_state = self._get_weights()  # init веса\n",
    "        self.matching_ticket = None               # пока тикет не обучен\n",
    "        self.masks = self._initialize_masks()\n",
    "        self.trace_log = {}                       # Tr(H) - паралельно считаем след оуенки Гессиана\n",
    "\n",
    "    def _get_weights(self):\n",
    "        return {k: v.clone().detach() for k, v in self.model.state_dict().items()}\n",
    "\n",
    "    def _initialize_masks(self):\n",
    "        \"\"\"\n",
    "        \"Полная\" маска без фильтраций \n",
    "        \"\"\"\n",
    "        # ПУНКТ 1 ИЗ АЛГОРИТМА\n",
    "        return {\n",
    "            name: torch.ones_like(param, dtype=torch.bool)\n",
    "            for name, param in self.model.named_parameters()\n",
    "            if \"weight\" in name\n",
    "        } \n",
    "\n",
    "    def _apply_mask(self):\n",
    "        \"\"\"\n",
    "        Накладываем новую маску\n",
    "        \"\"\"\n",
    "        with torch.no_grad():\n",
    "            for name, param in self.model.named_parameters():\n",
    "                if name in self.masks:\n",
    "                    param.data *= self.masks[name]\n",
    "\n",
    "    def _prune(self):\n",
    "        # перебираем слои и их веса\n",
    "        for name, param in self.model.named_parameters():\n",
    "            # численные слои\n",
    "            if name in self.masks:\n",
    "                # неотброшенные параметры\n",
    "                current_weights = param.data[self.masks[name]] \n",
    "                k = int(current_weights.numel() * self.pruning_ratio) # k весов на слое обнуляться при текущем pruning ratio\n",
    "                if k == 0: \n",
    "                    continue\n",
    "                threshold = current_weights.abs().kthvalue(k).values # трешхолд отсекающий k параметров\n",
    "                new_mask = (param.data.abs() > threshold) & self.masks[name] # объединяем текущую и новую маску логически\n",
    "                self.masks[name] = new_mask\n",
    "\n",
    "    def _reset_to_ticket(self):\n",
    "        \"\"\"\n",
    "        Rewinding до тикета\n",
    "        \"\"\"\n",
    "        self.model.load_state_dict(self.matching_ticket)\n",
    "        self._apply_mask()\n",
    "\n",
    "    def _log_sparsity(self, iteration):\n",
    "        total_params, zero_params = 0, 0\n",
    "        for name, param in self.model.named_parameters():\n",
    "            if name in self.masks:\n",
    "                mask = self.masks[name]\n",
    "                total_params += mask.numel()\n",
    "                zero_params += (~mask).sum().item()\n",
    "        sparsity = 100 * zero_params / total_params\n",
    "        print(f\"[IMP Iteration {iteration}] Sparsity: {sparsity:.2f}% ({total_params - zero_params} / {total_params} non-zero)\")\n",
    "\n",
    "    def _estimate_trace_hessian(self, dataloader, num_batches=1):\n",
    "        \"\"\"\n",
    "        Оценка следа Гессиана для трейнового куска через Hutchinson’s estimator\n",
    "        \"\"\"\n",
    "        self.model.eval()\n",
    "        # сюда будем суммировать оценки Tr(H) по батчам \n",
    "        trace_estimate = 0.0\n",
    "\n",
    "        for i, (inputs, targets) in enumerate(dataloader):\n",
    "            if i >= num_batches:\n",
    "                break\n",
    "\n",
    "            inputs, targets = inputs.to(device), targets.to(device)\n",
    "            self.model.zero_grad()\n",
    "            outputs = self.model(inputs)\n",
    "            loss = self.trainer.criterion(outputs, targets)\n",
    "\n", 
    "            # считаем градиенты loss по параметрам модели с сохранением вычислительного графа (нужно для второго дифференцирования)\n",
    "            grad_params = torch.autograd.grad(loss, self.model.parameters(), create_graph=True)\n",
    "\n",
    "            # генерируем случайные векторы v той же размерности, что и градиенты\n",
    "            v = [torch.randn_like(p) for p in grad_params]\n",
    "             # считаем Hessian-vector product: H * v (берём производную скалярного произведения градиента и v по параметрам) \n",
    "            Hv = torch.autograd.grad(grad_params, self.model.parameters(), grad_outputs=v, retain_graph=False)\n",
    "            # сумма v_i^T H v_i по всем слоям → это оценка Tr(H) для одного батча\n",
    "            # по сути это сумма произведений компонент v и Hv\n",
    "            trace_estimate += sum((vi * hvi).sum().item() for vi, hvi in zip(v, Hv))\n",
    "\n",
    "        return trace_estimate / num_batches\n",
    "\n",
    "    def run(self, C=5, T=20, T0=5):\n",
    "        \"\"\"\n",
    "        run IMP\n",
    "        \"\"\"\n",
    "        print(f\"\\n[IMP] Step 1: Getting matching ticket (T0={T0})...\")\n",
    "        self.model.load_state_dict(self.initial_state)\n",
    "        for epoch in range(1, T0 + 1):\n",
    "            # обучаем matching ticket T0 эпох (ПУНКТ 2 ИЗ АЛГОРИТМА)\n",
    "            self.trainer.train(epoch)\n",
    "            self.trainer.test()\n",
    "            self.trainer.scheduler.step()\n",
    "\n",
    "        self.matching_ticket = self._get_weights()\n",
    "\n",
    "        for c in range(1, C + 1):\n",
    "            print(f\"\\n[IMP Iteration {c}/{C}]\")\n",
    "            self._reset_to_ticket()\n",
    "            for epoch in range(1, T + 1):\n",
    "                self.trainer.train(epoch)\n",
    "                self.trainer.test()\n",
    "                self.trainer.scheduler.step()\n",
    "\n",
    "            # логгируем след гессиана\n",
    "            trace = self._estimate_trace_hessian(self.trainer.trainloader, num_batches=1)\n",
    "            self.trace_log[c] = trace\n",
    "            print(f\"[IMP Iteration {c}] Trace of Hessian: {trace:.4f}\")\n",
    "\n",
    "            self._prune()\n",
    "            self._log_sparsity(c)\n"
   ]
  },
